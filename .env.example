# Development: leave empty to use the origin of the local request.
# Production: set the exact public origin, e.g. https://pasport-dostupnosty.ru
APP_ORIGIN=
HOST=127.0.0.1
PORT=5173
DATABASE_PATH=./data/site.sqlite
# Docker only: change after a verified restore into a new directory in the volume.
CONTAINER_DATABASE_PATH=/app/data/site.sqlite
# 0 for direct access; 1 only when running behind one trusted reverse proxy.
TRUST_PROXY=0
# Generate once locally with npm run admin:setup.
ADMIN_PASSWORD_SCRYPT=
# Legacy configuration only. Run npm run admin:migrate to keep the password.
ADMIN_PASSWORD_SHA256=
ADMIN_SESSION_SECRET=
