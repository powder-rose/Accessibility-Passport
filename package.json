{
  "name": "boykov-accessibility-passport",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "node --import tsx server/index.ts",
    "build": "npm run typecheck && vite build && vite build --ssr server/index.ts --outDir dist/server",
    "start": "node dist/server/index.js --production",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.mjs tests/*.test.ts",
    "check": "npm run build && npm test",
    "admin:setup": "node scripts/setup-admin.mjs"
  },
  "dependencies": {
    "express": "5.3.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "tsx": "4.22.1",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  }
}
