{
  "name": "boykov-accessibility-passport",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "node --import tsx server/index.ts",
    "build": "npm run typecheck && vite build && vite build --ssr server/index.ts --outDir dist/server",
    "start": "node dist/server/index.js --production",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.mjs tests/*.test.ts",
    "check": "npm run format:check && npm run lint && npm run audit:check && npm run build && npm test",
    "admin:setup": "node scripts/setup-admin.mjs",
    "healthcheck": "node scripts/healthcheck.mjs",
    "db:backup": "node scripts/database.mjs backup",
    "db:verify": "node scripts/database.mjs verify",
    "db:restore": "node scripts/database.mjs restore",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "audit:check": "npm audit --audit-level=high --fetch-retries=1 --fetch-timeout=20000"
  },
  "dependencies": {
    "@tiptap/extension-image": "3.32.2",
    "@tiptap/extension-table": "3.32.2",
    "@tiptap/pm": "3.32.2",
    "@tiptap/react": "3.32.2",
    "@tiptap/starter-kit": "3.32.2",
    "express": "5.3.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sanitize-html": "2.18.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.6",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/sanitize-html": "2.16.2",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "tsx": "4.22.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6"
  }
}
